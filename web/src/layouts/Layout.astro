---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; robots?: string; socialImage?: string }
const { title, description, robots = 'index,follow', socialImage = '/hero/avanti-car-hero.webp' } = Astro.props;
const siteOrigin = (import.meta.env.SITE_URL ?? process.env.SITE_URL ?? Astro.url.origin).replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? process.env.PUBLIC_PLAUSIBLE_DOMAIN;
const configuredGoogleAnalyticsId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? process.env.PUBLIC_GA_MEASUREMENT_ID ?? '').trim();
const googleAnalyticsId = /^G-[A-Z0-9]+$/i.test(configuredGoogleAnalyticsId) ? configuredGoogleAnalyticsId : null;
const pageTitle = title.includes('Auto Reliability') ? title : `${title} | Auto Reliability`;
const socialImageUrl = socialImage.startsWith('http') ? socialImage : `${siteOrigin}${socialImage}`;
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=1800, stale-while-revalidate=86400');
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${siteOrigin}/#organization`, name: 'Auto Reliability Intelligence', url: siteOrigin, logo: `${siteOrigin}/brand/auto-reliability-logo.png`, sameAs: [] },
    { '@type': 'WebSite', '@id': `${siteOrigin}/#website`, name: 'Auto Reliability Intelligence', url: siteOrigin, publisher: { '@id': `${siteOrigin}/#organization` } },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#00B9F2" />
    <link rel="icon" type="image/png" href="/brand/auto-reliability-logo.png" />
    <link rel="apple-touch-icon" href="/brand/auto-reliability-logo.png" />
    <meta property="og:site_name" content="Auto Reliability Intelligence" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Auto Reliability Intelligence vehicle reliability research" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    {googleAnalyticsId ? <><script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script><script is:inline set:html={`window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${googleAnalyticsId}');`}></script></> : null}
    {plausibleDomain ? <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script> : null}
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
<style is:global>
  :root { color-scheme:dark; --brand-primary:#00b9f2; --brand-primary-rgb:0 185 242; font-family:'Inter',ui-sans-serif,system-ui,sans-serif; font-weight:400; color:#f4f4f5; background:#08090b; } * { box-sizing:border-box; } html,body { overflow-x:clip; } body { min-width:320px; margin:0; background:#08090b; letter-spacing:.01em; } .site-header { position:sticky; top:0; z-index:50; max-width:none; padding:.7rem max(1.25rem,calc((100vw - 1100px)/2)); border-bottom:1px solid rgb(255 255 255 / .08); background:#08090b; } main,.site-footer { max-width:1100px; margin:auto; padding-left:1.25rem; padding-right:1.25rem; } main { min-height:60vh; padding-top:2.2rem; padding-bottom:3rem; } .site-footer { padding-bottom:2rem; } a { color:var(--brand-primary); } h1,h2,h3 { color:#fff; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; } h1 { font-size:clamp(2rem,4vw,3.75rem); letter-spacing:-.025em; } table { width:100%; border-collapse:collapse; overflow:hidden; border:1px solid rgb(255 255 255 / .08); border-radius:14px; background:#12151c; } th,td { padding:.85rem; border-bottom:1px solid rgb(255 255 255 / .06); text-align:left; } th { color:#a1a1aa; font-size:.68rem; letter-spacing:.12em; text-transform:uppercase; }
  h1,h2,h3 { letter-spacing:.01em; line-height:1.08; } h1 { letter-spacing:.01em; }
  .eyebrow,.odi,.back,.ranking-head p,.ranking-card__rank,.not-found>p:first-child { color:var(--brand-primary) !important; }
</style>
