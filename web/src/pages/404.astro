---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found | Auto Reliability" description="The requested automotive reliability report is not available." robots="noindex,follow">
  <section class="not-found"><p>404</p><h1>Report not found.</h1><p>This vehicle report is not currently indexed. Search the directory to browse available models and years.</p><a href="/directory">Browse vehicle directory →</a></section>
</Layout>
<style>.not-found { max-width:650px; padding:4rem 0; }.not-found>p:first-child { color:#e5fe40; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.75rem; letter-spacing:.12em; }.not-found>p:nth-of-type(2) { color:#a1a1aa; line-height:1.6; }.not-found a { display:inline-block; margin-top:1rem; font-size:.75rem; font-weight:700; letter-spacing:.08em; text-decoration:none; text-transform:uppercase; }</style>
