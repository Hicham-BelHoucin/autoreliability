---
import AdSlot from '../../../../components/AdSlot.astro';
import FailureIntelligence from '../../../../components/FailureIntelligence.astro';
import Layout from '../../../../layouts/Layout.astro';
import { getAdjacentYears, getVehicle } from '../../../../lib/db';
import { getVehicleIllustration } from '../../../../lib/vehicle-illustrations';
export const prerender = false;
const { make, model, year: yearParam } = Astro.params;
const year = Number(yearParam);
if (!make || !model || !Number.isInteger(year)) return Astro.redirect('/404');
const vehicle = await getVehicle(make, model, year);
if (!vehicle) return new Response('Not found', { status: 404, statusText: 'Not Found' });
const adjacentYears = await getAdjacentYears(vehicle.make, vehicle.model, vehicle.year);
const hazardRatio = vehicle.totalComplaints ? ((vehicle.crashReports + vehicle.fireReports) / vehicle.totalComplaints * 100).toFixed(2) : '0.00';
const glow = 'var(--brand-primary)';
const topComponents = vehicle.componentBreakdown.slice(0, 10);
const remainingComponents = vehicle.componentBreakdown.slice(10);
const primaryComponent = topComponents[0];
const flaggedSafetyReports = vehicle.crashReports + vehicle.fireReports;
const isIndexable = vehicle.totalComplaints >= 10;
const vehicleIllustration = getVehicleIllustration(vehicle.make, vehicle.model);
const nearbyComparisons = adjacentYears.map((item) => ({
  ...item,
  difference: item.totalComplaints - vehicle.totalComplaints,
}));
const comparisonRange = adjacentYears.length
  ? `${Math.min(vehicle.totalComplaints, ...adjacentYears.map((item) => item.totalComplaints)).toLocaleString()}–${Math.max(vehicle.totalComplaints, ...adjacentYears.map((item) => item.totalComplaints)).toLocaleString()}`
  : null;
const lowerComplaintYears = adjacentYears.filter((item) => item.totalComplaints < vehicle.totalComplaints);
const higherComplaintYears = adjacentYears.filter((item) => item.totalComplaints > vehicle.totalComplaints);
const buyerSignal = vehicle.totalComplaints < 10
  ? { label: 'Limited dataset', detail: 'There are too few processed reports for a meaningful model-year comparison.' }
  : vehicle.reliabilityScore <= 3 || Number(hazardRatio) >= 3
    ? { label: 'Research carefully', detail: 'Review the underlying reports, recall status, and service history before making a vehicle-specific decision.' }
    : { label: 'Review source records', detail: 'Use the complaint patterns as a research starting point, alongside recalls, maintenance history, and an inspection.' };
const siteOrigin = (import.meta.env.SITE_URL ?? process.env.SITE_URL ?? Astro.url.origin).replace(/\/$/, '');
const canonical = `${siteOrigin}${Astro.url.pathname}`;
const vehicleName = `${vehicle.year} ${vehicle.make} ${vehicle.model}`;
const primarySystem = primaryComponent?.component.toLowerCase() ?? 'reported systems';
const description = `${vehicleName} reliability research: ${vehicle.totalComplaints.toLocaleString()} NHTSA complaints, ${primarySystem}, and pre-purchase inspection guidance.`;
const breadcrumbSchema = { '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: siteOrigin },
  { '@type': 'ListItem', position: 2, name: 'Vehicle directory', item: `${siteOrigin}/directory` },
  { '@type': 'ListItem', position: 3, name: vehicleName, item: canonical },
] };
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Vehicle', '@id': `${canonical}#vehicle`, name: vehicleName, productionDate: String(vehicle.year), brand: { '@type': 'Brand', name: vehicle.make }, model: vehicle.model, aggregateRating: { '@type': 'AggregateRating', ratingValue: vehicle.reliabilityScore, bestRating: 10, worstRating: 1, ratingCount: vehicle.totalComplaints }, isBasedOn: 'https://www.nhtsa.gov/', additionalProperty: vehicle.failureClusters.map((cluster) => ({ '@type': 'PropertyValue', name: `${cluster.componentCategory}: ${cluster.failureTitle}`, value: cluster.geoSummary })), url: canonical },
  { '@type': 'Dataset', '@id': `${canonical}#dataset`, name: `${vehicleName} NHTSA complaint dataset`, description, url: canonical, isBasedOn: 'https://www.nhtsa.gov/', creator: { '@id': `${siteOrigin}/#organization` }, temporalCoverage: `${vehicle.year}`, license: `${siteOrigin}/data-license`, isAccessibleForFree: true },
  breadcrumbSchema,
] };
---
<Layout title={`${vehicleName} Reliability, Problems & NHTSA Complaints`} description={description} socialImage={vehicleIllustration} robots={isIndexable ? 'index,follow' : 'noindex,follow'}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/directory">Vehicle directory</a><span aria-hidden="true">/</span><span aria-current="page">{vehicleName}</span></nav>
  <section class="report-head"><p class="eyebrow">Federal telemetry verified <span>●</span> Model-year dossier</p><h1>{vehicle.year} {vehicle.make} {vehicle.model}</h1><p>Complaint-pattern analysis from publicly available NHTSA safety records.</p></section>
  <figure class="vehicle-portrait"><img src={vehicleIllustration} width="1200" height="675" alt={`Illustrative rendering of a ${vehicle.year} ${vehicle.make} ${vehicle.model}`} loading="eager" decoding="async" fetchpriority="high" /><figcaption>Illustrative vehicle rendering. Not an official manufacturer image.</figcaption></figure>
  <section class="scorecard" style={`--glow:${glow}; --score:${vehicle.reliabilityScore * 10}%`}><div class="score"><div class="gauge"><strong>{vehicle.reliabilityScore.toFixed(1)}</strong><span>Reliability score / 10</span></div></div><div class="score-summary"><p class="eyebrow">System health index</p><h2>Reliability telemetry</h2><p>A cohort-relative signal that annualizes documented reports for vehicle age and weights NHTSA crash or fire flags.</p></div><div class="metrics-grid"><div><span>Documented incidents</span><strong>{vehicle.totalComplaints.toLocaleString()}</strong></div><div><span>Reports with crash / fire flags</span><strong>{flaggedSafetyReports}</strong></div><div><span>Flagged-report share</span><strong>{hazardRatio}%</strong></div><div><span>Primary reported system</span><strong class="system">{vehicle.primaryFailureComponent ?? 'Unclassified'}</strong></div></div><p class="metric-note">Scores are relative to the indexed vehicle cohort, not failure rates. Crash and fire flags identify how a complaint was recorded by NHTSA; they do not establish that a reported component caused the event.</p></section>
  <a class="source-reports-link" href={`/reliability/${vehicle.make.toLowerCase()}/${vehicle.model.toLowerCase()}/${vehicle.year}/reports`}>View NHTSA source reports <span>{vehicle.totalComplaints.toLocaleString()} documented reports →</span></a>
  <a class="compare-link" href={`/compare?left=${encodeURIComponent(`${vehicle.make}|${vehicle.model}|${vehicle.year}`)}`}>Compare this vehicle <span>Choose another model →</span></a>
  <section class="buyer-guidance" aria-labelledby="buyer-guidance-title">
    <div class="guidance-heading"><p class="eyebrow">Data-based buyer guidance</p><h2 id="buyer-guidance-title">{buyerSignal.label}</h2><p>{buyerSignal.detail}</p></div>
    <div class="guidance-insights">
      <article><span>Dataset signal</span><p>This model year has <strong>{vehicle.totalComplaints.toLocaleString()} processed complaint reports</strong>{primaryComponent ? <>; <strong>{primaryComponent.component}</strong> is the most frequently classified system at <strong>{primaryComponent.percentage.toFixed(1)}%</strong> of reports.</> : '.'}</p></article>
      <article><span>Model-year context</span><p>{adjacentYears.length ? <>Available adjacent years span <strong>{comparisonRange} reports</strong>. {lowerComplaintYears.length ? <>This year has more reports than {lowerComplaintYears.map((item) => item.year).join(' and ')}.</> : null} {higherComplaintYears.length ? <>It has fewer reports than {higherComplaintYears.map((item) => item.year).join(' and ')}.</> : null} {!lowerComplaintYears.length && !higherComplaintYears.length ? 'Available adjacent years have the same report total.' : null}</> : 'Adjacent model-year records are not yet available for a direct comparison.'}</p></article>
    </div>
    <div class="guidance-actions"><strong>Before you buy</strong><ol><li>Check open recalls using the vehicle identification number (VIN).</li><li>Review the linked NHTSA reports for symptoms that match the vehicle you are considering.</li><li>Ask for maintenance records and arrange an independent pre-purchase inspection.</li></ol></div>
    <p class="guidance-disclaimer">This is a statistical research aid, not a mechanical diagnosis, failure prediction, or recommendation to buy or avoid a vehicle.</p>
  </section>
  <AdSlot label="Sponsored intelligence placement" />
  <section class="breakdown"><div class="section-title"><p class="eyebrow">Component analysis</p><h2>Most frequently reported systems.</h2></div><div class="component-list">{topComponents.length ? topComponents.map((item) => <article class="component"><div><strong>{item.component}</strong><span>{item.complaints} documented reports</span></div><div class="bar"><i style={`width:${Math.min(item.percentage, 100)}%`}></i></div><b>{item.percentage.toFixed(1)}%</b></article>) : <p class="empty">No component-level telemetry is available for this model year.</p>}</div>{remainingComponents.length ? <details class="all-components"><summary>Show all {vehicle.componentBreakdown.length} reported components</summary><div class="component-list">{remainingComponents.map((item) => <article class="component"><div><strong>{item.component}</strong><span>{item.complaints} documented reports</span></div><div class="bar"><i style={`width:${Math.min(item.percentage, 100)}%`}></i></div><b>{item.percentage.toFixed(1)}%</b></article>)}</div></details> : null}</section>
  <FailureIntelligence clusters={vehicle.failureClusters} />
  <section class="takeaway"><p class="eyebrow">What the data says</p><p>{primaryComponent ? `${primaryComponent.component} is the most frequently classified component, appearing in ${primaryComponent.percentage.toFixed(1)}% of complaint reports in this dataset. This ${vehicle.year} ${vehicle.make} ${vehicle.model} has ${vehicle.totalComplaints.toLocaleString()} complaint reports in the records we have processed. One report can be classified under more than one component, so component shares do not add up to 100%.` : `This ${vehicle.year} ${vehicle.make} ${vehicle.model} has ${vehicle.totalComplaints.toLocaleString()} complaint reports in the records we have processed, but no component classifications are currently available.`}</p></section>
  <section class="year-nav"><p class="eyebrow">Compare model years</p>{nearbyComparisons.length ? <p class="comparison-note">These nearby model years have {nearbyComparisons.map((item) => `${item.year}: ${item.totalComplaints.toLocaleString()} reports`).join(' · ')}. Complaint totals are not failure rates and should be read with vehicle age, sales volume, and reporting patterns in mind.</p> : null}<div>{adjacentYears.length ? adjacentYears.map((item) => <a href={`/reliability/${item.make.toLowerCase()}/${item.model.toLowerCase()}/${item.year}`}>{item.year} <span>{item.reliabilityScore.toFixed(1)}</span></a>) : <p class="empty">No nearby model years are currently indexed for comparison.</p>}</div></section>
</Layout>
<style>
  .breadcrumbs { display:flex; flex-wrap:wrap; gap:.45rem; margin:.15rem 0 1.25rem; color:#71717a; font-size:.72rem; }.breadcrumbs a { color:#a1a1aa; text-decoration:none; }.breadcrumbs a:hover { color:var(--brand-primary); }.report-head { padding:1rem 0 2rem; }.eyebrow { margin:0; color:#e5fe40; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.66rem; letter-spacing:.14em; text-transform:uppercase; }.eyebrow span { font-size:.5rem; vertical-align:1px; }.report-head h1 { margin:.75rem 0; font-size:clamp(2.5rem,6vw,4.7rem); font-weight:900; line-height:.98; text-transform:capitalize; }.report-head>p:last-child { color:#a1a1aa; }.vehicle-portrait { position:relative; aspect-ratio:16/9; margin:0 0 1.5rem; overflow:hidden; border:1px solid rgb(255 255 255 / .10); border-radius:18px; background:#0b0d11; }.vehicle-portrait img { width:100%; height:100%; object-fit:cover; object-position:center; }.vehicle-portrait figcaption { position:absolute; right:1rem; bottom:.8rem; margin:0; color:#a1a1aa; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.55rem; letter-spacing:.06em; text-transform:uppercase; }.scorecard { display:grid; grid-template-columns:210px 1fr; gap:2rem; padding:2rem; border:1px solid rgb(255 255 255 / .10); border-radius:18px; background:#12151c; }.score { display:grid; place-items:center; }.gauge { width:175px; aspect-ratio:1; display:grid; place-content:center; border:10px solid var(--glow); border-radius:50%; background:#08090b; text-align:center; }.gauge strong { color:#fff; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:3rem; letter-spacing:-.12em; }.gauge span { margin-top:.25rem; color:#a1a1aa; font-size:.57rem; font-weight:700; letter-spacing:.09em; text-transform:uppercase; }.score-summary { align-self:center; }.score-summary h2 { margin:.5rem 0; font-size:1.7rem; letter-spacing:-.04em; }.score-summary>p:last-child { color:#a1a1aa; line-height:1.6; }.metrics-grid { grid-column:1/-1; display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid rgb(255 255 255 / .08); }.metrics-grid div { min-width:0; padding:1.25rem 1rem 0; border-right:1px solid rgb(255 255 255 / .08); }.metrics-grid div:first-child { padding-left:0; }.metrics-grid div:last-child { border:0; }.metrics-grid span { display:block; color:#71717a; font-size:.61rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }.metrics-grid strong { display:block; overflow-wrap:anywhere; margin-top:.5rem; color:#fff; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:1.45rem; letter-spacing:-.08em; }.metrics-grid .system { color:var(--glow); font-family:Inter,sans-serif; font-size:.95rem; letter-spacing:-.02em; }.breakdown { margin:4.5rem 0; }.section-title h2 { margin:.5rem 0 1.5rem; font-size:clamp(1.8rem,3vw,2.5rem); letter-spacing:-.05em; }.component-list { display:grid; gap:.7rem; }.component { display:grid; grid-template-columns:minmax(150px,1fr) minmax(130px,2fr) 55px; gap:1rem; align-items:center; padding:1rem; border:1px solid rgb(255 255 255 / .08); border-radius:12px; background:#12151c; }.component div:first-child { display:grid; gap:.3rem; }.component strong { color:#fff; }.component span { color:#71717a; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.62rem; }.bar { height:10px; overflow:hidden; border-radius:99px; background:#272a31; }.bar i { display:block; height:100%; border-radius:inherit; background:#e5fe40; }.component b { color:#fff; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.72rem; text-align:right; }.takeaway { margin:4rem 0; padding:1.6rem 1.8rem; border:1px solid rgb(255 255 255 / .08); border-left:2px solid #e5fe40; border-radius:0 14px 14px 0; background:#12151c; }.takeaway>p:last-child { max-width:800px; margin:.8rem 0 0; color:#d4d4d8; line-height:1.75; }.year-nav { padding:1.6rem; border:1px solid rgb(255 255 255 / .08); border-radius:15px; background:#0d0f14; }.year-nav>div { display:flex; flex-wrap:wrap; gap:.65rem; margin-top:1rem; }.year-nav a { padding:.55rem .85rem; border:1px solid rgb(255 255 255 / .10); border-radius:999px; color:#d4d4d8; font-size:.72rem; font-weight:700; text-decoration:none; transition:border .2s,color .2s; }.year-nav a:hover { border-color:#e5fe40; color:#fff; }.year-nav a span { margin-left:.25rem; color:#e5fe40; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; }.empty { color:#71717a; } @media (max-width:700px) { .vehicle-portrait { margin-bottom:1rem; border-radius:14px; }.vehicle-portrait figcaption { right:.75rem; bottom:.6rem; font-size:.48rem; }.scorecard { grid-template-columns:1fr; }.score { justify-content:start; }.score-summary { margin-top:-1rem; }.metrics-grid { grid-template-columns:1fr; gap:1rem; }.metrics-grid div,.metrics-grid div:first-child { padding:0; border:0; }.component { grid-template-columns:1fr 50px; }.bar { grid-column:1/-1; grid-row:2; }.component b { grid-column:2; grid-row:1; }.breakdown { margin:3rem 0; } }
  .report-head h1 { font-weight:800; line-height:1.04; } .score-summary h2,.section-title h2 { letter-spacing:.01em; }
  .metric-note { grid-column:1/-1; margin:0; padding-top:1rem; border-top:1px solid rgb(255 255 255 / .08); color:#a1a1aa; font-size:.72rem; line-height:1.55; }.all-components { margin-top:1rem; }.all-components summary { width:max-content; cursor:pointer; color:#e5fe40; font-size:.72rem; font-weight:700; letter-spacing:.06em; }.all-components[open] summary { margin-bottom:1rem; }.comparison-note { max-width:780px; margin:1rem 0 0; color:#a1a1aa; font-size:.8rem; line-height:1.6; }
  .source-reports-link { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-top:1rem; padding:1rem 1.25rem; border:1px solid rgb(229 254 64 / .38); border-radius:12px; color:#fff; background:#12151c; font-size:.82rem; font-weight:700; text-decoration:none; }.source-reports-link:hover { border-color:#e5fe40; }.source-reports-link span { color:#e5fe40; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.68rem; white-space:nowrap; }.compare-link { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-top:.7rem; padding:.85rem 1.1rem; border:1px solid rgb(255 255 255 / .12); border-radius:12px; color:#fff; background:#0d0f14; font-size:.78rem; font-weight:700; text-decoration:none; }.compare-link:hover { border-color:var(--brand-primary); }.compare-link span { color:var(--brand-primary); font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.66rem; white-space:nowrap; } @media (max-width:600px) { .source-reports-link,.compare-link { align-items:flex-start; flex-direction:column; } }
  .buyer-guidance { margin:1.25rem 0 3rem; padding:1.6rem; border:1px solid rgb(229 254 64 / .3); border-radius:16px; background:#12151c; }.guidance-heading h2 { margin:.45rem 0 .55rem; font-size:clamp(1.75rem,3vw,2.35rem); letter-spacing:.01em; }.guidance-heading>p:last-child { max-width:720px; margin:0; color:#d4d4d8; line-height:1.6; }.guidance-insights { display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-top:1.4rem; }.guidance-insights article { padding:1rem; border:1px solid rgb(255 255 255 / .08); border-radius:10px; background:#0d0f14; }.guidance-insights span,.guidance-actions>strong { color:#e5fe40; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.62rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }.guidance-insights p { margin:.55rem 0 0; color:#a1a1aa; font-size:.82rem; line-height:1.6; }.guidance-insights p strong { color:#f4f4f5; }.guidance-actions { margin-top:1rem; padding:1rem; border-left:2px solid #e5fe40; background:#0d0f14; }.guidance-actions ol { display:grid; gap:.4rem; margin:.7rem 0 0; padding-left:1.1rem; color:#d4d4d8; font-size:.8rem; line-height:1.55; }.guidance-disclaimer { margin:1rem 0 0; color:#a1a1aa; font-size:.7rem; line-height:1.5; } @media (max-width:700px) { .guidance-insights { grid-template-columns:1fr; }.buyer-guidance { padding:1.25rem; } }
  .eyebrow,.all-components summary,.source-reports-link span,.guidance-insights span,.guidance-actions>strong,.year-nav a span { color:var(--brand-primary); }.bar i { background:var(--brand-primary); }.takeaway,.guidance-actions { border-left-color:var(--brand-primary); }.source-reports-link { border-color:rgb(var(--brand-primary-rgb) / .38); }.source-reports-link:hover { border-color:var(--brand-primary); }.buyer-guidance { border-color:rgb(var(--brand-primary-rgb) / .3); }
</style>
