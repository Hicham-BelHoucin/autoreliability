---
import Layout from '../layouts/Layout.astro';
import { getComparisonOptions, getVehicle, type ComparisonOption, type Vehicle } from '../lib/db';
export const prerender = false;
const options = await getComparisonOptions();
const keyFor = (vehicle: Pick<ComparisonOption, 'make' | 'model' | 'year'>) => `${vehicle.make}|${vehicle.model}|${vehicle.year}`;
const selectOption = (value: string | null) => options.find((option) => keyFor(option) === value) ?? null;
const leftOption = selectOption(Astro.url.searchParams.get('left'));
const rightOption = selectOption(Astro.url.searchParams.get('right'));
const [left, right] = await Promise.all([leftOption ? getVehicle(leftOption.make, leftOption.model, leftOption.year) : null, rightOption ? getVehicle(rightOption.make, rightOption.model, rightOption.year) : null]);
const vehicleName = (vehicle: Vehicle) => `${vehicle.year} ${vehicle.make} ${vehicle.model}`;
const metrics = left && right ? [
  ['Reliability score', left.reliabilityScore.toFixed(1), right.reliabilityScore.toFixed(1), 'Higher is better'],
  ['Documented incidents', left.totalComplaints.toLocaleString(), right.totalComplaints.toLocaleString(), 'Complaint count'],
  ['Crash reports', left.crashReports.toLocaleString(), right.crashReports.toLocaleString(), 'NHTSA crash flags'],
  ['Fire reports', left.fireReports.toLocaleString(), right.fireReports.toLocaleString(), 'NHTSA fire flags'],
  ['Leading reported system', left.primaryFailureComponent ?? 'Unclassified', right.primaryFailureComponent ?? 'Unclassified', 'Most common complaint classification'],
] : [];
---
<Layout title="Compare Vehicle Reliability" description="Compare complaint-based reliability data for two indexed vehicles.">
  <header class="compare-head"><p class="eyebrow">Vehicle comparison</p><h1>Compare two vehicles.</h1><p>Review complaint volume, safety flags, and leading reported systems side by side.</p></header>
  <form class="compare-form" method="get"><label>First vehicle<select name="left" required><option value="">Choose a vehicle</option>{options.map((option) => <option value={keyFor(option)} selected={keyFor(option) === keyFor(leftOption ?? { make: '', model: '', year: 0 })}>{option.year} {option.make} {option.model}</option>)}</select></label><label>Second vehicle<select name="right" required><option value="">Choose a vehicle</option>{options.map((option) => <option value={keyFor(option)} selected={keyFor(option) === keyFor(rightOption ?? { make: '', model: '', year: 0 })}>{option.year} {option.make} {option.model}</option>)}</select></label><button type="submit">Compare vehicles</button></form>
  {left && right ? <section class="comparison" aria-label={`${vehicleName(left)} compared with ${vehicleName(right)}`}><div class="vehicle-labels"><a href={`/reliability/${left.make.toLowerCase()}/${left.model.toLowerCase()}/${left.year}`}>{vehicleName(left)}</a><span>vs</span><a href={`/reliability/${right.make.toLowerCase()}/${right.model.toLowerCase()}/${right.year}`}>{vehicleName(right)}</a></div><div class="metric-table">{metrics.map(([label, leftValue, rightValue, note]) => <article><div><span>{label}</span><small>{note}</small></div><strong>{leftValue}</strong><strong>{rightValue}</strong></article>)}</div><p class="disclaimer">Complaint counts are not failure rates. Read them with vehicle age, sales volume, maintenance history, recalls, and a qualified pre-purchase inspection in mind.</p></section> : <section class="empty"><h2>Select two vehicles to compare.</h2><p>Only vehicles already indexed by the reliability pipeline are shown.</p></section>}
</Layout>
<style>
  .compare-head { padding:1rem 0 2rem; }.eyebrow { margin:0; color:var(--brand-primary); font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.68rem; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }.compare-head h1 { margin:.55rem 0; font-size:clamp(2.6rem,5vw,4.5rem); }.compare-head>p:last-child { max-width:640px; color:#a1a1aa; line-height:1.6; }.compare-form { display:grid; grid-template-columns:1fr 1fr auto; gap:.75rem; align-items:end; padding:1rem; border:1px solid rgb(255 255 255 / .1); border-radius:14px; background:#12151c; }.compare-form label { display:grid; gap:.4rem; color:#d4d4d8; font-size:.76rem; font-weight:700; }.compare-form select { width:100%; min-width:0; padding:.72rem; border:1px solid rgb(255 255 255 / .14); border-radius:8px; color:#fff; background:#0d0f14; font:inherit; }.compare-form button { padding:.76rem 1rem; border:0; border-radius:8px; background:var(--brand-primary); color:#061018; font:inherit; font-size:.72rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; cursor:pointer; }.comparison { margin:2rem 0; }.vehicle-labels { display:grid; grid-template-columns:1fr auto 1fr; gap:1rem; align-items:center; margin-bottom:1rem; }.vehicle-labels a { color:#fff; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-size:clamp(1.25rem,2.5vw,2rem); font-weight:800; text-decoration:none; }.vehicle-labels a:last-child { text-align:right; }.vehicle-labels span { color:var(--brand-primary); font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.72rem; font-weight:700; }.metric-table { border:1px solid rgb(255 255 255 / .1); border-radius:14px; overflow:hidden; }.metric-table article { display:grid; grid-template-columns:1.35fr 1fr 1fr; gap:1rem; align-items:center; padding:1rem; border-bottom:1px solid rgb(255 255 255 / .08); background:#12151c; }.metric-table article:last-child { border:0; }.metric-table div { display:grid; gap:.22rem; }.metric-table span { color:#fff; font-weight:700; }.metric-table small { color:#71717a; font-size:.67rem; }.metric-table strong { color:var(--brand-primary); font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.82rem; text-align:right; }.disclaimer,.empty p { color:#a1a1aa; font-size:.78rem; line-height:1.6; }.empty { margin:2rem 0; padding:1.5rem; border:1px solid rgb(255 255 255 / .09); border-radius:14px; background:#12151c; }.empty h2 { margin-top:0; } @media(max-width:700px) { .compare-form { grid-template-columns:1fr; }.vehicle-labels { grid-template-columns:1fr; text-align:center; }.vehicle-labels a:last-child { text-align:center; }.metric-table article { grid-template-columns:1fr 1fr; }.metric-table article div { grid-column:1/-1; }.metric-table strong { text-align:left; } }
</style>
