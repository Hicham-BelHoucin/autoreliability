---
import Layout from '../layouts/Layout.astro';
import { getAvailableMakes, getLeaderboard } from '../lib/db';
import { getMakeThumbnail } from '../lib/vehicle-illustrations';

const [makes, problemVehicles] = await Promise.all([getAvailableMakes(), getLeaderboard(8)]);
const commonProblems = problemVehicles.filter((vehicle) => vehicle.primaryFailureComponent).slice(0, 4);
---
<Layout title="Auto Reliability Intelligence | Vehicle Problems & Reliability" description="Research vehicle complaints, common problems, and reliability patterns using public NHTSA safety data.">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Public safety data, made useful</p>
      <h1>Know What Breaks<br /><em>Before You Buy.</em></h1>
      <p class="lede">Real-world vehicle complaints, recalls, and reliability insights based on public NHTSA safety data.</p>
      <form class="vehicle-search" action="/directory" method="get">
        <label><span>Search your vehicle</span><input name="q" type="search" placeholder="Enter a make, model, or year" required /></label>
        <button type="submit">Check reliability <b>→</b></button>
      </form>
      <p class="trust">NHTSA public safety data <i>•</i> Indexed vehicle records <i>•</i> Updated regularly</p>
    </div>
    <aside class="hero-visual" aria-label="Illustrative vehicle rendering">
      <img src="/hero/avanti-car-hero.webp" width="1536" height="768" alt="Silver luxury sedan parked beside a lake" loading="eager" decoding="async" />
    </aside>
  </section>

  <section class="make-section" aria-labelledby="makes-heading"><div class="section-title"><div><p class="eyebrow">Browse vehicles</p><h2 id="makes-heading">Explore by manufacturer.</h2></div><a href="/directory">All vehicles →</a></div>{makes.length ? <div class="make-grid">{makes.map((make) => <a href={`/directory?q=${encodeURIComponent(make)}`}><img src={getMakeThumbnail(make)} width="480" height="240" loading="lazy" decoding="async" alt={`Illustrative vehicle rendering for ${make} reliability reports`} /><span class="make-card-copy"><strong>{make}</strong><span>View vehicles →</span></span></a>)}</div> : <p class="empty">Vehicle records are being synchronized. Please check back soon.</p>}</section>

  <section class="problem-section" aria-labelledby="problems-heading"><div class="section-title"><div><p class="eyebrow">Complaint rankings</p><h2 id="problems-heading">Vehicles with the most reported problems.</h2></div><a href="/rankings">See all rankings →</a></div>{problemVehicles.length ? <div class="ranking-list">{problemVehicles.slice(0, 5).map((vehicle, index) => <a href={`/reliability/${vehicle.make.toLowerCase()}/${vehicle.model.toLowerCase()}/${vehicle.year}`}><span class="rank">{String(index + 1).padStart(2, '0')}</span><strong>{vehicle.make} {vehicle.model}</strong><span class="year">{vehicle.year}</span><span class="complaints">{vehicle.totalComplaints.toLocaleString()} complaints</span><span class="component">{vehicle.primaryFailureComponent ?? 'Component data unavailable'}</span><b>→</b></a>)}</div> : <p class="empty">Rankings will appear after vehicle data is synchronized.</p>}</section>

  {commonProblems.length ? <section class="common-section" aria-labelledby="common-heading"><div class="section-title"><div><p class="eyebrow">From the data</p><h2 id="common-heading">Commonly reported problems.</h2></div></div><div class="common-grid">{commonProblems.map((vehicle) => <a href={`/reliability/${vehicle.make.toLowerCase()}/${vehicle.model.toLowerCase()}/${vehicle.year}`}><p>{vehicle.year} {vehicle.make} {vehicle.model}</p><strong>{vehicle.primaryFailureComponent}</strong><span>{vehicle.totalComplaints.toLocaleString()} documented complaints</span><small>{vehicle.primaryFailureComponent} is the most frequently classified component in the records we have processed for this model year.</small><i>View reliability report →</i></a>)}</div></section> : null}

  <section class="how" aria-labelledby="how-heading"><div><p class="eyebrow">How it works</p><h2 id="how-heading">Built from real safety reports.</h2></div><div class="steps"><article><span>01</span><h3>Collect</h3><p>Public vehicle complaint and recall records from NHTSA.</p></article><article><span>02</span><h3>Analyze</h3><p>Reports are grouped by vehicle, model year, and affected component.</p></article><article><span>03</span><h3>Compare</h3><p>Patterns across vehicles and years make recurring issues easier to identify.</p></article></div><p class="disclaimer">Complaint volume alone does not prove a defect or determine a vehicle’s overall reliability. Review official recalls and obtain a qualified inspection before making a purchase or repair decision.</p></section>
</Layout>
<style>
  .hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(330px,.82fr); gap:3rem; align-items:center; padding:3.5rem 0 3rem; }.eyebrow { margin:0; color:#e5fe40; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.67rem; letter-spacing:.14em; text-transform:uppercase; }.hero h1 { margin:.8rem 0 1.1rem; font-size:clamp(3.1rem,7vw,6rem); font-weight:900; line-height:.94; }.hero h1 em { color:#a1a1aa; font-style:normal; }.lede { max-width:570px; color:#c4c4ca; font-size:1.06rem; line-height:1.7; }.vehicle-search { display:flex; max-width:680px; margin:2rem 0 .8rem; padding:.4rem; border:1px solid rgb(255 255 255 / .11); border-radius:14px; background:#12151c; }.vehicle-search label { flex:1; min-width:0; }.vehicle-search label span { position:absolute; width:1px; height:1px; overflow:hidden; }.vehicle-search input { width:100%; padding:.8rem; border:0; outline:0; background:transparent; color:#fff; font:inherit; }.vehicle-search input::placeholder { color:#71717a; }.vehicle-search button { border:0; border-radius:10px; padding:.75rem 1rem; background:#e5fe40; color:#08090b; font-size:.7rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }.vehicle-search b { margin-left:.4rem; font-size:1.1rem; }.trust { color:#71717a; font-size:.72rem; }.trust i { margin:0 .25rem; color:#e5fe40; font-style:normal; }.hero-visual { position:relative; aspect-ratio:4/5; overflow:hidden; margin:0; border:1px solid rgb(255 255 255 / .10); border-radius:18px; background:#0d0f14; }.hero-visual>img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }.visual-label { position:absolute; top:1.1rem; left:1.1rem; max-width:220px; display:grid; gap:.35rem; }.visual-label span,.hero-visual>p { color:#a1a1aa; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.56rem; letter-spacing:.08em; text-transform:uppercase; }.visual-label strong { color:#fff; font-size:1rem; line-height:1.15; }.hero-visual ul { position:absolute; right:1.1rem; bottom:2.5rem; display:grid; gap:.45rem; margin:0; padding:0; list-style:none; color:#d4d4d8; font-size:.68rem; text-align:right; }.hero-visual li { display:flex; align-items:center; justify-content:end; gap:.45rem; }.hero-visual li b { color:#e5fe40; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.62rem; }.hero-visual>p { position:absolute; right:1.1rem; bottom:.7rem; margin:0; font-size:.45rem; }.make-section,.problem-section,.common-section,.how { margin-top:4.5rem; }.section-title { display:flex; align-items:end; justify-content:space-between; gap:1rem; margin-bottom:1.4rem; }.section-title h2,.how h2 { margin:.45rem 0 0; font-size:clamp(1.8rem,3vw,2.6rem); letter-spacing:-.05em; }.section-title>a { color:#e5fe40; font-size:.7rem; font-weight:800; letter-spacing:.09em; text-decoration:none; text-transform:uppercase; white-space:nowrap; }.make-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:.7rem; }.make-grid a { min-height:100px; display:flex; flex-direction:column; justify-content:space-between; padding:1rem; border:1px solid rgb(255 255 255 / .08); border-radius:12px; background:#12151c; color:#fff; text-decoration:none; transition:border .2s,transform .2s; }.make-grid a:hover { border-color:#e5fe40; transform:translateY(-2px); }.make-grid strong { font-size:1.05rem; }.make-grid span,.common-grid i { color:#a1a1aa; font-size:.65rem; font-style:normal; font-weight:700; letter-spacing:.07em; text-transform:uppercase; }.ranking-list { border-top:1px solid rgb(255 255 255 / .08); }.ranking-list a { display:grid; grid-template-columns:42px 1.3fr .55fr .9fr 1fr 20px; gap:.8rem; align-items:center; padding:1rem .25rem; border-bottom:1px solid rgb(255 255 255 / .08); color:#fff; text-decoration:none; }.ranking-list a:hover { color:#e5fe40; }.rank,.year { color:#71717a; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.73rem; }.complaints,.component { color:#a1a1aa; font-size:.78rem; }.ranking-list b { font-size:1rem; }.common-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:.75rem; }.common-grid a { display:grid; gap:.7rem; padding:1.3rem; border:1px solid rgb(255 255 255 / .08); border-radius:14px; background:#12151c; color:#fff; text-decoration:none; transition:border .2s; }.common-grid a:hover { border-color:#e5fe40; }.common-grid p { margin:0; color:#a1a1aa; font-size:.76rem; }.common-grid strong { color:#e5fe40; font-size:.9rem; letter-spacing:.04em; }.common-grid span { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.67rem; }.common-grid small { color:#a1a1aa; line-height:1.55; }.how { padding:2rem; border:1px solid rgb(255 255 255 / .08); border-radius:16px; background:#0d0f14; }.steps { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-top:2rem; }.steps article { border-top:1px solid rgb(255 255 255 / .1); padding-top:1rem; }.steps span { color:#e5fe40; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.7rem; }.steps h3 { margin:.7rem 0 .4rem; }.steps p,.disclaimer { color:#a1a1aa; font-size:.85rem; line-height:1.6; }.disclaimer { max-width:850px; margin:2rem 0 0; padding-top:1rem; border-top:1px solid rgb(255 255 255 / .08); }.empty { color:#a1a1aa; } @media (max-width:750px) { .hero { grid-template-columns:1fr; gap:2rem; padding-top:2.5rem; }.hero-visual { max-width:520px; aspect-ratio:16/10; }.make-grid { grid-template-columns:repeat(2,1fr); }.ranking-list a { grid-template-columns:34px 1fr 20px; }.ranking-list .year,.ranking-list .complaints,.ranking-list .component { display:none; }.common-grid,.steps { grid-template-columns:1fr; }.vehicle-search { flex-direction:column; }.vehicle-search button { width:100%; }.make-section,.problem-section,.common-section,.how { margin-top:3.3rem; } }
  .hero h1 { font-weight:800; line-height:1.04; } .section-title h2,.how h2 { letter-spacing:.01em; }
  .hero { position:relative; left:50%; width:100vw; display:flex; justify-content:center; height:calc(100vh - 75px); height:calc(100svh - 75px); min-height:0; margin-top:-2.2rem; margin-left:-50vw; overflow:hidden; padding:4.5rem 2rem 2rem; border:0; border-radius:0; background:#08090b; text-align:center; }
  .hero-copy { position:relative; z-index:2; width:min(100%,720px); }
  .hero .lede { margin-right:auto; margin-left:auto; }
  .vehicle-search { margin-right:auto; margin-left:auto; }
  .hero-visual { position:absolute; inset:0; z-index:0; aspect-ratio:auto; max-width:none; margin:0; border:0; border-radius:0; background:#08090b; }
  .hero-visual::after { position:absolute; inset:0; content:''; background:rgb(4 6 8 / .56); }
  .hero-visual>img { position:static; width:100%; height:100%; object-fit:cover; object-position:center; }
  @media (max-width:750px) { .hero { min-height:570px; padding:3rem 1rem 1rem; }.hero-copy { width:100%; }.hero h1 { font-size:clamp(2.8rem,14vw,4rem); }.hero-visual>img { object-position:center; } }
  .make-grid a { position:relative; display:block; min-height:172px; padding:0; overflow:hidden; background:#12151c; }.make-grid a>img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; border:0; opacity:.84; transform:scale(1.18); transition:transform .3s ease; }.make-grid a::after { position:absolute; inset:0; content:''; background:rgb(8 9 11 / .34); }.make-grid a:hover>img { transform:scale(1.24); }.make-card-copy { position:relative; z-index:1; display:flex; height:172px; flex-direction:column; justify-content:space-between; padding:1rem; }.make-card-copy>span { color:#e5fe40; }.make-card-copy strong { color:#fff; text-shadow:0 2px 10px rgb(0 0 0 / .8); }
</style>
