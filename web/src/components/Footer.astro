---
const topMakes = ['Ford', 'Toyota', 'Honda', 'Chevrolet', 'Nissan', 'Ram', 'Jeep', 'Hyundai', 'Subaru', 'Volkswagen'];
---
<footer class="site-footer">
  <section class="footer-brand"><strong><img src="/brand/auto-reliability-mark.svg" width="28" height="28" alt="" /> Auto Reliability</strong><p>Independent defect telemetry for deliberate vehicle decisions.</p><small>Live federal telemetry synthesis. Statistical research only.</small></section>
  <section><h2>Explore</h2><a href="/directory">Vehicle directory</a><a href="/rankings">Incident rankings</a><a href="/about">Methodology</a></section>
  <section><h2>Top makes</h2><div class="make-list">{topMakes.map((make) => <a href={`/directory#${make.toLowerCase()}`}>{make}</a>)}</div></section>
  <section><h2>Legal</h2><a href="/privacy">Privacy Policy</a><a href="/terms">Terms of Service</a><a href="/disclaimer">Disclaimer</a><a href="/contact">Contact</a></section>
  <p class="copyright">© {new Date().getFullYear()} Auto Reliability Intelligence <span>•</span> Federal public-record analysis</p>
</footer>
<style>
  .site-footer { display:grid; grid-template-columns:1.4fr repeat(3,1fr); gap:2rem; padding-top:3rem; border-top:1px solid rgb(255 255 255 / .06); background:#08090b; }
  .footer-brand strong { display:flex; align-items:center; gap:.5rem; color:#fff; font-size:.88rem; text-transform:uppercase; letter-spacing:.04em; }.footer-brand img { display:block; width:28px; height:28px; } h2 { margin:0 0 .85rem; color:#fff; font-size:.68rem; letter-spacing:.15em; text-transform:uppercase; } p { margin:.65rem 0; color:#a1a1aa; line-height:1.6; } small { color:#71717a; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.66rem; letter-spacing:.04em; } section a { display:block; width:max-content; max-width:100%; margin:.48rem 0; color:#a1a1aa; font-size:.82rem; text-decoration:none; transition:color .2s; } section a:hover { color:#e5fe40;}.make-list { columns:2; } .copyright { grid-column:1/-1; margin:0; padding-top:1.2rem; border-top:1px solid rgb(255 255 255 / .06); color:#71717a; font-size:.7rem; letter-spacing:.05em; text-transform:uppercase; }.copyright span { color:#e5fe40; } @media (max-width:720px) { .site-footer { grid-template-columns:1fr 1fr; } } @media (max-width:440px) { .site-footer { grid-template-columns:1fr; } }
</style>
