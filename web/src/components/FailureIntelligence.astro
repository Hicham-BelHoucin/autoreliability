---
import type { FailureCluster } from '../lib/db';
interface Props { clusters: FailureCluster[]; }
const { clusters } = Astro.props;
const mileageLabel = (cluster: FailureCluster) => cluster.mileageP25 !== null && cluster.mileageP75 !== null ? `${cluster.mileageP25.toLocaleString()}–${cluster.mileageP75.toLocaleString()} mi` : 'Mileage not reported';
---
{clusters.length ? <section class="failure-intelligence" aria-labelledby="failure-intelligence-title">
  <div class="heading"><p class="eyebrow">Failure intelligence</p><h2 id="failure-intelligence-title">What to inspect before you buy.</h2><p>Complaint clusters identify repeated reported symptoms; they are not a diagnosis or defect finding.</p></div>
  <div class="clusters">{clusters.map((cluster) => <article class="cluster">
    <header><div><p>{cluster.componentCategory}</p><h3>{cluster.failureTitle}</h3></div><strong>{cluster.complaintCount} reports</strong></header>
    <div class="danger-zone"><span>Danger zone mileage</span><b>{mileageLabel(cluster)}</b>{cluster.mileageMedian !== null ? <small>Median: {cluster.mileageMedian.toLocaleString()} mi</small> : null}</div>
    {cluster.symptoms.length ? <div><h4>Reported symptoms</h4><ul>{cluster.symptoms.map((symptom) => <li>{symptom}</li>)}</ul></div> : null}
    <div class="inspection"><h4>Pre-purchase check</h4><p>{cluster.inspectionAdvice}</p></div><p class="geo">{cluster.geoSummary}</p>{cluster.matchedTsbId ? <p class="tsb">Related service bulletin: {cluster.matchedTsbId}</p> : null}
  </article>)}</div>
</section> : null}
<style>
  .failure-intelligence { margin:4.5rem 0; }.heading h2 { margin:.5rem 0; font-size:clamp(1.8rem,3vw,2.5rem); letter-spacing:.01em; }.heading>p:last-child { max-width:720px; color:#a1a1aa; line-height:1.6; }.clusters { display:grid; gap:1rem; margin-top:1.5rem; }.cluster { padding:1.25rem; border:1px solid rgb(var(--brand-primary-rgb) / .28); border-radius:14px; background:#12151c; }.cluster header { display:flex; justify-content:space-between; gap:1rem; }.cluster header p,.danger-zone span,.cluster h4,.tsb { margin:0; color:var(--brand-primary); font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.62rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }.cluster h3 { margin:.45rem 0 0; font-size:1.2rem; }.cluster header strong { align-self:start; color:#fff; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.7rem; white-space:nowrap; }.danger-zone { display:grid; gap:.25rem; margin:1rem 0; padding:.8rem; border-left:2px solid var(--brand-primary); background:#0d0f14; }.danger-zone b { color:#fff; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; }.danger-zone small { color:#a1a1aa; }.cluster ul { display:flex; flex-wrap:wrap; gap:.45rem; margin:.55rem 0 1rem; padding:0; list-style:none; }.cluster li { padding:.35rem .55rem; border:1px solid rgb(255 255 255 / .12); border-radius:999px; color:#d4d4d8; font-size:.75rem; }.inspection { padding:.85rem; border-radius:8px; background:#0d0f14; }.inspection p,.geo { margin:.5rem 0 0; color:#d4d4d8; font-size:.82rem; line-height:1.6; }.geo { color:#a1a1aa; }.tsb { margin-top:1rem; } @media(max-width:600px) { .cluster header { display:block; }.cluster header strong { display:block; margin-top:.7rem; } }
</style>
